# Скопируй этот файл в .env (в этой же папке) и впиши свой токен.
# Как получить токен — SETUP.md.

# OAuth-токен Яндекса с доступом webmaster:hostinfo (живёт 6 месяцев).
YANDEX_WEBMASTER_TOKEN=

# Необязательно: ID пользователя Вебмастера. Если пусто, скрипт узнает его сам через GET /v4/user.
YANDEX_WEBMASTER_USER_ID=
